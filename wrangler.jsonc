// Cloudflare Workers config: serves the built Vite app (dist/) as static
// files on aflaahqc.com and its portal subdomains. Supabase env vars are
// baked in at build time (VITE_*), so the Worker itself has no secrets.
// worker/index.js only runs for /api/* (email sending), and for / and /login
// (keeps the staff portals out of search results); everything else is served
// straight from dist/.
{
  "name": "aflaah-app",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/login"]
  },
  // Admin → Notifications emails, via Cloudflare Email Service. The sender
  // domain must be onboarded under Email Service → Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // Check my Reading: Whisper speech-to-text, the backup when the class's
  // Quran listener Space (QURAN_ASR_URL below) can't answer (see worker/recitation.js).
  "ai": { "binding": "AI" },
  "vars": {
    "EMAIL_FROM": "noreply@aflaahqc.com",
    "EMAIL_FROM_NAME": "Aflaah Quran Class",
    // Check my Reading's listener (asr-server/ on a Hugging Face Space), e.g.
    // "https://<user>-aflaah-quran-listener.hf.space". Empty: Whisper only.
    // The Space's secret LISTENER_TOKEN goes here too: npx wrangler secret put LISTENER_TOKEN
    "QURAN_ASR_URL": "",
    // The public (anon) key — the same one shipped in the app. The Worker
    // calls Supabase with the signed-in admin's own token.
    // Phone notifications (Web Push). The private half is the secret
    // VAPID_PRIVATE_JWK: npx wrangler secret put VAPID_PRIVATE_JWK
    // Admin alerts also need ALERT_SECRET (the Vault secret
    // 'admin_alert_secret', see 20261028_admin_alerts.sql).
    "VAPID_PUBLIC_KEY": "BCoYQ_A_boa81YQbEYA4-pUbCqgnbDdzOY_ssrT4N83WYW0RUNECvfjD2sowEvlwSQadCwbEE3Fn8nMFI0I4rCM",
    "SUPABASE_URL": "https://iejkdoyugkewgoyzuvad.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imllamtkb3l1Z2tld2dveXp1dmFkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0ODIxNzUsImV4cCI6MjEwMjA1ODE3NX0.Bwyw526xUVbOQwfScF2HJQP4CEBJ3KAmyskqpwnnrxk"
  },
  "routes": [
    { "pattern": "aflaahqc.com", "custom_domain": true },
    { "pattern": "admin.aflaahqc.com", "custom_domain": true },
    { "pattern": "teachers.aflaahqc.com", "custom_domain": true },
    { "pattern": "students.aflaahqc.com", "custom_domain": true }
  ]
}
